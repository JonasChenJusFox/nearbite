MONGO_URI=mongodb+srv://UserName:YourPassword@cluster0.example.mongodb.net/?retryWrites=true&w=majority&appName=Cluster0
MONGO_DBNAME=NearBite
MONGO_TIMEOUT_MS=2000

# Optional. If MONGO_URI is unset, NearBite stores user/signup data in this JSON file.
# Cloudflare Containers have ephemeral disks; production requires MongoDB.
NEARBITE_LOCAL_DB_PATH=data/local_db.json
# The Cloudflare Worker sets this to true; keep false for local JSON development.
NEARBITE_REQUIRE_MONGO=false

# Must match the offline embedding assets in data/restaurant_embeddings.json.
EMBEDDING_MODEL=sentence-transformers/multi-qa-mpnet-base-cos-v1

# fast avoids loading the embedding model at runtime; semantic enables full vector search.
NEARBITE_SEARCH_MODE=fast
